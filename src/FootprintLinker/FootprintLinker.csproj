<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>FootprintLinker</AssemblyName><RootNamespace>FootprintLinker</RootNamespace>
    <Version>1.0.0</Version><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Web/**/*" /><Content Remove="Web/**/*" /><None Remove="Web/**/*" /></ItemGroup>
</Project>
